# ============================================================================
# Anora Backend Production Environment Configuration
# ============================================================================
# 
# Copy this file to .env in your production deployment environment
# and fill in the values for your AWS/GCP resources.
#
# CRITICAL (Hard Failure if Missing):
#   - DATABASE_URL (must be valid PostgreSQL connection string)
#   - AWS_REGION (required for SNS push notifications)
#

# ============================================================================
# DATABASE CONFIGURATION (CRITICAL)
# ============================================================================
# PostgreSQL connection string for production database.
# Format: postgresql://[user[:password]@][host][:port]/[dbname][?param=value]
# 
# MUST be a valid, accessible connection string pointing to your prod database.
# No default provided - this is a hard failure if missing.
#
# Example: postgresql://anora_user:SecurePassword123@prod-db.c.myproject.iam:5432/anora_prod
DATABASE_URL=postgresql://user:password@hostname:5432/dbname

# Database connection timeout in seconds (default: 8)
DB_CONNECT_TIMEOUT_SECONDS=8

# Number of retries for database connection on startup (default: 6)
DB_CONNECT_RETRIES=6

# Delay between connection retry attempts in seconds (default: 5)
DB_RETRY_DELAY_SECONDS=5

# ============================================================================
# CORS CONFIGURATION
# ============================================================================
# Comma-separated list of allowed origins for CORS requests.
# In production, restrict to your actual frontend URL to prevent unauthorized access.
# 
# Examples:
#   - Single origin: https://d1p1fpleu1yzws.cloudfront.net
#   - Multiple origins: https://d1p1fpleu1yzws.cloudfront.net,https://app.anora.health
#   - Allow all (NOT RECOMMENDED FOR PRODUCTION): *
#
# Default: * (allow all) - CHANGE THIS for production!
ALLOWED_ORIGINS=https://d1p1fpleu1yzws.cloudfront.net

# ============================================================================
# AWS CONFIGURATION (For SNS Push Notifications)
# ============================================================================
# AWS region where SNS and other services are deployed.
# REQUIRED if using push notifications, otherwise optional.
# No default provided - this is a hard failure if SNS is needed and region is missing.
#
# Examples: us-east-1, us-west-2, eu-west-1
AWS_REGION=us-east-1

# Fallback region if AWS_REGION is not set (rarely needed)
AWS_DEFAULT_REGION=

# ============================================================================
# AWS SNS PLATFORM APPLICATION ARNS
# ============================================================================
# ARN (Amazon Resource Name) for platform-specific SNS applications.
# These are used to send push notifications to iOS and Android devices.
#
# No defaults - these are optional but required if push notifications are enabled.
#
# To find your ARNs:
#   1. Go to AWS SNS Console > Mobile > Platform Applications
#   2. Copy the ARN for each platform
#
# Examples:
#   iOS:     arn:aws:sns:us-east-1:027277540377:app/GCM/anora-ios
#   Android: arn:aws:sns:us-east-1:027277540377:app/GCM/anora-android

# iOS push notifications (optional, required if push enabled)
AWS_SNS_PLATFORM_APPLICATION_ARN_IOS=arn:aws:sns:us-east-1:ACCOUNT_ID:app/APNS/anora-ios

# Android push notifications (optional, required if push enabled)
AWS_SNS_PLATFORM_APPLICATION_ARN_ANDROID=arn:aws:sns:us-east-1:ACCOUNT_ID:app/GCM/anora-android

# Generic fallback (optional, rarely used)
AWS_SNS_PLATFORM_APPLICATION_ARN=

# ============================================================================
# ENVIRONMENT METADATA (Informational)
# ============================================================================
# These are purely informational and not used by the backend.
# Include them to document your deployment.

# Deployment environment name (e.g., prod, staging, dev)
DEPLOYMENT_ENV=production

# Application version (should match your backend release tag)
APP_VERSION=1.0.0

# Timestamp of deployment
DEPLOYED_AT=2026-05-02T00:00:00Z

# ============================================================================
# DEPLOYMENT VERIFICATION CHECKLIST
# ============================================================================
# Before deploying, verify:
#
# [ ] DATABASE_URL points to a real, accessible PostgreSQL instance
# [ ] AWS_REGION is set to where your resources live
# [ ] ALLOWED_ORIGINS includes your CloudFront CDN URL (not "*")
# [ ] AWS SNS ARNs are filled in if you're using push notifications
# [ ] .env file is NOT committed to git (check .gitignore)
# [ ] Secrets are stored securely (AWS Secrets Manager, GCP Secret Manager, etc.)
#
# Quick validation:
#   python -c "import os; from dotenv import load_dotenv; load_dotenv(); assert os.getenv('DATABASE_URL'), 'DATABASE_URL not set'"
#
# ============================================================================
